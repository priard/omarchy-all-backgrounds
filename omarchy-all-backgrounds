#!/bin/bash
# omarchy-all-backgrounds: opens the last viewed view (every theme's backgrounds or ~/Backgrounds);
# Up/Down in the picker switch views (needs the patched picker), running it again closes the picker.
# Usage: omarchy-all-backgrounds [folder]   (default folder: ~/Backgrounds)

# Never a shared /tmp path: another user could plant or redirect it.
state=${XDG_RUNTIME_DIR:-$HOME/.cache}/omarchy-all-backgrounds.run
last_view_file=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-all-backgrounds/last-view
home_dir=${1:-$HOME/Backgrounds}  # optional arg: your own backgrounds folder
marker=omarchy-all-backgrounds

# Second press while our picker is open: close it.
read -r owner 2>/dev/null <"$state"
if [[ -n $owner ]] && kill -0 "$owner" 2>/dev/null; then
  omarchy-shell image-selector cancel "" >/dev/null
  exit 0
fi
echo "$$" >"$state"

selection_file=$(mktemp)
done_file=$(mktemp -u)
trap 'rm -f "$selection_file" "$done_file"; read -r owner 2>/dev/null <"$state"; [[ $owner == "$$" ]] && rm -f "$state"' EXIT

current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

has_home_media() {
  [[ -n $(find -L "$home_dir" -maxdepth 1 -type f -iregex '.*\.\(jpe?g\|png\|gif\|bmp\|webp\|mp4\|m4v\|mov\|webm\|mkv\|avi\)' -print -quit 2>/dev/null) ]]
}

# Building rows and thumbnails can take a while on first open: show an OSD until the picker is up.
picker_up() { hyprctl layers -j | grep -q '"omarchy-image-selector"'; }
show_loading() {
  sleep 0.3
  picker_up && return
  omarchy osd -i 󰋩 -m "Loading backgrounds…" -d 60000
  for _ in {1..600}; do
    picker_up && break
    sleep 0.1
  done
  omarchy-shell osd close >/dev/null
}

# Echo the folder holding every theme's backgrounds: "<theme> · <n>" symlinks (the picker label shows
# the name), content duplicates dropped (md5 only for same-size files).
all_themes_dir() {
  local dirs list all_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-all-backgrounds
  shopt -s nullglob
  dirs=(/usr/share/omarchy/themes/*/backgrounds "$HOME"/.config/omarchy/themes/*/backgrounds "$HOME"/.config/omarchy/backgrounds/*/)
  dirs=("${dirs[@]%/}")
  # Paths with a tab or newline are skipped: they could forge records in this tab/line format.
  list=$(for dir in "${dirs[@]}"; do
      find -L "$dir" -maxdepth 1 -type f ! -path $'*\n*' ! -path $'*\t*' -printf '%s\t%h\t%f\t%p\n' | sort -t $'\t' -k3
    done | awk -F '\t' '
      NF != 4 { next }
      {
        theme[NR] = $2; sub(/\/backgrounds$/, "", theme[NR]); sub(/.*\//, "", theme[NR])
        size[NR] = $1; ext[NR] = $3; path[NR] = $4; count[$1]++
      }
      END {
        for (i = 1; i <= NR; i++) {
          if (!(i in path)) continue
          key = size[i]
          if (count[key] > 1) {
            p = path[i]; gsub(/'\''/, "'\''\\'\'''\''", p)
            cmd = "md5sum < '\''" p "'\''"; cmd | getline key; close(cmd)
          }
          if (!seen[key]++) {
            sub(/.*\./, "", ext[i])
            print theme[i] " · " ++n[theme[i]] "." ext[i] "\t" path[i]
          }
        }
      }' | sort)
  if [[ $list != "$(cat "$all_dir.list" 2>/dev/null)" ]]; then
    rm -rf "$all_dir" && mkdir -p "$all_dir"
    while IFS=$'\t' read -r name path; do ln -s "$path" "$all_dir/$name"; done <<<"$list"
    printf '%s' "$list" >"$all_dir.list"
  fi
  echo "$all_dir"
}

# Adds each still image's own WIDTHxHEIGHT as a third column, from one
# vipsheader run, so the patched picker can show it (Omarchy 4.5's
# omarchy-menu-images has no --sizes yet). Kept while the rows stay the same.
with_sizes() {
  local rows=$1 cache=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-all-backgrounds.sizes
  local key path thumbnail line out="" images=()
  local -A size=()

  key=$(printf '%s' "$rows" | md5sum)
  key=${key%% *}
  if [[ $(cat "$cache.key" 2>/dev/null) == "$key" ]]; then
    cat "$cache.rows"
    return
  fi

  while IFS=$'\t' read -r path _; do
    [[ -n $path && ! ${path,,} =~ \.(mp4|m4v|mov|webm|mkv|avi)$ ]] && images+=("$path")
  done <<<"$rows"
  if (( ${#images[@]} > 0 )); then
    while IFS= read -r line; do
      [[ $line =~ ^(.*):\ ([0-9]+)x([0-9]+)\  ]] && size[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}x${BASH_REMATCH[3]}"
    done < <(vipsheader "${images[@]}" 2>/dev/null)
  fi

  while IFS=$'\t' read -r path thumbnail; do
    [[ -n $path ]] || continue
    line="$path"$'\t'"$thumbnail"
    [[ -n ${size[$path]:-} ]] && line+=$'\t'"${size[$path]}"
    out+="$line"$'\n'
  done <<<"$rows"

  printf '%s' "$out" >"$cache.rows"
  printf '%s' "$key" >"$cache.key"
  printf '%s' "$out"
}

# Reopen the last viewed view.
mode=all
[[ $(cat "$last_view_file" 2>/dev/null) == home ]] && has_home_media && mode=home

# Close any open picker first (e.g. the stock one), so the loading OSD shows instead of a stale view.
omarchy-shell image-selector cancel "" >/dev/null

while :; do
  mkdir -p "${last_view_file%/*}" && echo "$mode" >"$last_view_file"
  show_loading &
  loader=$!

  if [[ $mode == home ]]; then
    dir=$home_dir title=${home_dir/#$HOME/\~}
  else
    dir=$(all_themes_dir) title="All themes"
  fi
  # The picker only offers Up/Down when there is another view to switch to.
  views=""
  has_home_media && views="$marker:$title"

  rows=$(omarchy-menu-images --lazy-thumbnails --print-rows "$dir")
  rows=$(with_sizes "$rows")
  selected=$(find -L "$dir" -maxdepth 1 -type f -samefile "$current_background" -print -quit 2>/dev/null)

  : >"$selection_file"
  rm -f "$done_file"
  # omarchy-menu-images cannot pass a view title, so open the picker over the shell IPC directly.
  if [[ $(omarchy-shell image-selector open "$views" "$(printf '%s' "$rows" | base64 -w 0)" \
      "$selected" "$selection_file" "$done_file" true true) != ok ]]; then
    kill "$loader" 2>/dev/null && omarchy-shell osd close >/dev/null
    echo "omarchy-all-backgrounds: image selector did not accept the request" >&2
    exit 1
  fi

  while [[ ! -e $done_file ]]; do sleep 0.05; done
  background=$(<"$selection_file")

  case $background in
    "$marker":*) [[ $mode == home ]] && mode=all || mode=home ;;
    "") exit 0 ;;
    *) omarchy-theme-bg-set "$background"; exit 0 ;;
  esac
done
